# ==============================================================================
# CarbonSphere Web & API (Vercel Unified Deployment)
# ==============================================================================

# Supabase (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_publishable_or_anon_key

# Routing
OSRM_ENDPOINT=https://router.project-osrm.org

# API Endpoint (Leave empty in Vercel production for same-origin /api routing; set to http://localhost:8000 for local standalone dev)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Map Tiles (Optional)
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key

